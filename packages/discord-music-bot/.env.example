# Discord application bot token (Replit Secret in production)
DISCORD_BOT_TOKEN=

# Node hosting the bot's Discord slash commands; normally BOT_OWNER_IDS is a
# comma-separated list of Discord user IDs.
BOT_OWNER_IDS=

# PostgreSQL. Replit may provide DATABASE_URL automatically; otherwise set it.
DATABASE_URL=

# Lavalink v4 server (password is a Replit Secret)
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_IDENTIFIER=primary

# Optional additional nodes as JSON. Each item: id, host, port, password, secure.
# Keep passwords in Replit Secrets; do not commit this file with values.
LAVALINK_NODES=[]

# Optional Redis URL (Replit Secret). Redis is a resilient cache, not a startup dependency.
REDIS_URL=

DEFAULT_PREFIX=*
DEFAULT_SEARCH_PLATFORM=ytsearch
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_TRACKS=500
COMMAND_COOLDOWN_MS=1500
LOG_LEVEL=info
MAINTENANCE_MODE=false