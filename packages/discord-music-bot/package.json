{
  "name": "@workspace/discord-music-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "ioredis": "^5.8.2",
    "lavalink-client": "^2.11.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}